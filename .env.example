PORT=3000
CMS_ADMIN_USERNAME=admin
CMS_ADMIN_PASSWORD=change-me
CMS_SESSION_SECRET=change-me-to-a-long-random-string
# CMS_COOKIE_SECURE=true

# AI Assistant (website chat)
AI_ASSISTANT_ENABLED=true
AI_ASSISTANT_MAX_REQUESTS=40
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_TIMEOUT_MS=20000
# OPENAI_MAX_TOKENS=300
# OPENAI_TEMPERATURE=0.4

# Optional paths (useful for hosted deployments with a persistent disk)
# CMS_DATA_DIR=/var/data
# CMS_DB_PATH=/var/data/db.json
# CMS_UPLOADS_DIR=/var/data/uploads
# CMS_UPLOADS_URL_PREFIX=/uploads
